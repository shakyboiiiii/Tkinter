import tkinter as tk
from tkinter import messagebox
import random
CHOICES = ["Rock", "Paper", "Scissors"]
def evaluate(user_choice, comp_choice):
    if user_choice == comp_choice:
        return "Tie"
    # Rock beats Scissors, Scissors beats Paper, Paper beats Rock
    wins = {
        "Rock": "Scissors",
        "Scissors": "Paper",
        "Paper": "Rock",
    }
    if wins[user_choice] == comp_choice:
        return "You Win"
    else:
        return "Computer Wins"
class RPSTkApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Rock Paper Scissors - TKinter")
        self.user_score = 0
        self.comp_score = 0
        self.tie_count = 0
        self.top_frame = tk.Frame(root)
        self.top_frame.pack(pady=10)
        self.middle_frame = tk.Frame(root)
        self.middle_frame.pack(pady=10)
        self.bottom_frame = tk.Frame(root)
        self.bottom_frame.pack(pady=10)
        title = tk.Label(self.top_frame, text="Rock, Paper, Scissors", font=("Helvetica", 16, "bold"))
        title.pack()
        self.score_label = tk.Label(self.top_frame, text=self._format_score(), font=("Helvetica", 12))
        self.score_label.pack(pady=(5, 0))
        self.display_frame = tk.Frame(self.middle_frame)
        self.display_frame.pack()
        self.user_label = tk.Label(self.display_frame, text="You: -", font=("Helvetica", 12))
        self.user_label.grid(row=0, column=0, padx=20)
        self.vs_label = tk.Label(self.display_frame, text="VS", font=("Helvetica", 12, "bold"))
        self.vs_label.grid(row=0, column=1, padx=20)
        self.comp_label = tk.Label(self.display_frame, text="Computer: -", font=("Helvetica", 12))
        self.comp_label.grid(row=0, column=2, padx=20)
        self.result_label = tk.Label(self.bottom_frame, text="Make your move!", font=("Helvetica", 12))
        self.result_label.pack()
        self.buttons_frame = tk.Frame(self.root)
        self.buttons_frame.pack(pady=10)
        self.rock_btn = tk.Button(self.buttons_frame, text="Rock", width=12, command=lambda: self.play("Rock"))
        self.rock_btn.grid(row=0, column=0, padx=5, pady=5)
        self.paper_btn = tk.Button(self.buttons_frame, text="Paper", width=12, command=lambda: self.play("Paper"))
        self.paper_btn.grid(row=0, column=1, padx=5, pady=5)
        self.scissors_btn = tk.Button(self.buttons_frame, text="Scissors", width=12, command=lambda: self.play("Scissors"))
        self.scissors_btn.grid(row=0, column=2, padx=5, pady=5)
        self.reset_btn = tk.Button(self.root, text="Reset Score", width=12, command=self.reset_score)
        self.reset_btn.pack(pady=(0, 10))
    def _format_score(self):
        return f"Score - You: {self.user_score}  Computer: {self.comp_score}  Ties: {self.tie_count}"
    def play(self, user_choice):
        comp_choice = random.choice(CHOICES)
        result = evaluate(user_choice, comp_choice)
        self.user_label.config(text=f"You: {user_choice}")
        self.comp_label.config(text=f"Computer: {comp_choice}")
        self.result_label.config(text=result)
        if result == "You Win":
            self.user_score += 1
        elif result == "Computer Wins":
            self.comp_score += 1
        else:
            self.tie_count += 1
        self.score_label.config(text=self._format_score())
    def reset_score(self):
        self.user_score = 0
        self.comp_score = 0
        self.tie_count = 0
        self.user_label.config(text="You: -")
        self.comp_label.config(text="Computer: -")
        self.result_label.config(text="Scores reset. Make your move!")
        self.score_label.config(text=self._format_score())
if __name__ == "__main__":
    root = tk.Tk()
    app = RPSTkApp(root)
    root.mainloop()
