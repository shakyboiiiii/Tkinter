import tkinter as tk
window = tk.Tk()
window.geometry("400x400")
window.title("Length Converter App")
window.configure(bg="#1e1e2e")  # dark purple-ish vibe
title_label = tk.Label(
    window,
    text="Length Converter",
    font=("Arial", 18, "bold"),
    bg="#1e1e2e",
    fg="#ffffff"
)
title_label.pack(pady=20)
entry = tk.Entry(
    window,
    font=("Arial", 14),
    width=20,
    bg="#ffffff"
)
entry.pack(pady=10)
convert_button = tk.Button(
    window,
    text="Convert",
    font=("Arial", 12),
    bg="#4CAF50",
    fg="white",
    width=15
)
convert_button.pack(pady=10)
result_label = tk.Label(
    window,
    text="Result will appear here",
    font=("Arial", 12),
    bg="#1e1e2e",
    fg="#ffffff"
)
result_label.pack(pady=20)
window.mainloop()
