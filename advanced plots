import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
data = pd.read_csv("Iris.csv")
print(data.head())
plt.figure()
sns.barplot(x="Species", y="SepalLengthCm", data=data)
plt.title("Bar Plot of Sepal Length by Species")
plt.show()
plt.figure()
sns.countplot(x="Species", data=data)
plt.title("Count of Each Iris Species")
plt.show()
plt.figure()
sns.boxplot(x="Species", y="SepalWidthCm", data=data)
plt.title("Box Plot of Sepal Width by Species")
plt.show()
plt.figure()
sns.swarmplot(x="Species", y="SepalWidthCm", data=data)
plt.title("Swarm Plot of Sepal Width by Species")
plt.show()
plt.figure()
sns.distplot(data["SepalWidthCm"])
plt.title("Distribution of Sepal Width")
plt.show()
sns.jointplot(x="SepalLengthCm", y="SepalWidthCm", data=data, kind="scatter")
plt.show()
sns.pairplot(data, hue="Species")
plt.show()
