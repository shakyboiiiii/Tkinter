import tkinter as tk
import re
root = tk. Tk()
root. title("Password Strength Checker")
root.geometry("350x200")
def check():
    p = entry.get()
    if len(p) < 6:
        result.config(text="Weak", fg="red")
    elif re.search("[A-Z]", p) and re.search("[0-9]", p):
        result.config(text="Strong", fg="green")
    else:
        result.config(text="Medium", fg="orange")
tk.Label(root, text="Enter Password").pack(pady=10)
entry = tk. Entry(root, show="*", width=25)
entry.pack()
tk. Button(root, text="Check Strength", command=check).pack(pady=10)
result = tk.Label(root, text="", font=("Arial", 14))
result.pack()
root.mainloop()
